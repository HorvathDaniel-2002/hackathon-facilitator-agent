# ---- Database -------------------------------------------------------------
# SQLite for local development. Changing providers requires reviewed,
# provider-specific schemas, migrations and integration tests.
DATABASE_URL="file:./prisma/dev.db"

# ---- Authentication -------------------------------------------------------
# dev   = seeded local users, no real identity check. Local development only.
# entra = planned Microsoft Entra ID integration; currently fails closed.
#
# Dev identity works only on loopback in development/test, never in production.
# Production packaging can build, but does not implement or validate SSO.
AUTH_MODE="dev"

# Planned settings only; filling these in does not enable Entra sign-in yet.
# AZURE_AD_CLIENT_ID=""
# AZURE_AD_CLIENT_SECRET=""
# AZURE_AD_TENANT_ID=""
# NEXTAUTH_URL="http://localhost:3000"
# NEXTAUTH_SECRET=""

# ---- Azure OpenAI ---------------------------------------------------------
# Explicit mock mode for the synthetic demo and automated tests.
# To use a real approved resource, set AI_PROVIDER="azure-openai" and supply
# ALL endpoint/key/deployment values. Incomplete real config fails explicitly.
AI_PROVIDER="mock"

# AZURE_OPENAI_ENDPOINT="https://<your-resource>.openai.azure.com"
# AZURE_OPENAI_API_KEY=""
# AZURE_OPENAI_DEPLOYMENT="<your-deployment-name>"
# AZURE_OPENAI_API_VERSION="2024-10-21"

# Per-user daily cap on AI calls, protecting the shared Azure OpenAI quota.
AI_DAILY_CALL_BUDGET="100"
AI_MAX_CONCURRENT_PER_USER="2"
AI_MAX_CONCURRENT_CALLS="8"
